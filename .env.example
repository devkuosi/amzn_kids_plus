# Amazon account credentials
AMAZON_EMAIL=your_email@example.com
AMAZON_PASSWORD=your_password

# Optional: Timeout settings (in seconds)
PAGE_LOAD_TIMEOUT=30
ELEMENT_WAIT_TIMEOUT=10

# Optional: Headless mode (true/false)
HEADLESS=false

# Optional: Maximum iterations for content loading loop (default: 100)
MAX_ITERATIONS=100

# Optional: CSS selector for checked checkboxes (customize based on Amazon's page structure)
# Default: input[type="checkbox"]:checked
# CHECKBOX_SELECTOR=input[type="checkbox"]:checked

# Optional: Link text for navigating to content management page
# Default: Manage Content
# CONTENT_LINK_TEXT=Manage Content
